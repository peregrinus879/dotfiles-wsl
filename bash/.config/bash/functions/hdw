# Create or focus a Herdr Dev Workspace: one herdr workspace per project with a
# full-width AI agent tab plus an editor/shell tab.
# Layout: 1:<agent> | 2:editor+terminal ($EDITOR over a 25% shell)
# Usage: hdw <cc|oc> [-c]   cc = Claude Code, oc = OpenCode; -c continues the
# agent's last conversation in this project. Bare hdw refocuses an existing
# project workspace. One agent per workspace by design (single writer).
# Herdr socket commands need a running server and do not auto-start one; hdw
# starts the server headless when it is down, so one invocation works from a
# cold boot. If the headless start fails, hdw attaches plain herdr with a hint
# to rerun hdw inside (documented two-step fallback).
hdw() {
  local agent="" tab_label="" continue_flag="" arg
  for arg in "$@"; do
    case "$arg" in
      cc | oc)
        if [[ -n $agent ]]; then
          echo "hdw: choose one agent, cc or oc"
          return 1
        fi
        if [[ $arg == cc ]]; then agent="claude" tab_label="claude-code"; else agent="opencode" tab_label="opencode"; fi
        ;;
      -c) continue_flag=" -c" ;;
      *)
        echo "Usage: hdw <cc|oc> [-c]"
        return 1
        ;;
    esac
  done

  local root ws_label
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(pwd -P)
  # Same transform as the tmux launcher, so both name a project identically
  ws_label=$(basename "$root" | tr '.:' '--')

  # Workspace ids recycle across server restarts, so the collision record is
  # keyed by label: label, workspace id at creation, project root.
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hdw"
  local state_file="$state_dir/roots"

  if ! herdr status server 2>/dev/null | grep -q '^status: running'; then
    local i
    setsid -f herdr server >/dev/null 2>&1
    for ((i = 0; i < 20; i++)); do
      herdr status server 2>/dev/null | grep -q '^status: running' && break
      sleep 0.25
    done
    if ! herdr status server 2>/dev/null | grep -q '^status: running'; then
      echo "hdw: headless server start failed; attaching plain herdr, rerun hdw inside."
      herdr
      return
    fi
  fi

  local ws_id recorded_root=""
  ws_id=$(herdr workspace list 2>/dev/null |
    jq -r --arg l "$ws_label" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -n 1)

  if [[ -n $ws_id ]]; then
    [[ -f $state_file ]] && recorded_root=$(awk -F '\t' -v l="$ws_label" '$1 == l { print $3; exit }' "$state_file")
    if [[ -n $recorded_root && $recorded_root != "$root" ]]; then
      echo "herdr workspace '$ws_label' belongs to $recorded_root; close it or focus it manually."
      return 1
    fi
    [[ -z $recorded_root ]] && echo "hdw: focusing '$ws_label', a workspace hdw did not create"
    [[ -n $agent || -n $continue_flag ]] && echo "hdw: workspace exists, arguments ignored"
    herdr workspace focus "$ws_id" >/dev/null
  else
    if [[ -z $agent ]]; then
      echo "Usage: hdw <cc|oc> [-c]"
      return 1
    fi
    local created agent_pane agent_tab editor_pane
    created=$(herdr workspace create --cwd "$root" --label "$ws_label" --no-focus) || return 1
    ws_id=$(jq -r '.result.workspace.workspace_id' <<<"$created")
    agent_pane=$(jq -r '.result.root_pane.pane_id' <<<"$created")
    agent_tab=$(jq -r '.result.tab.tab_id' <<<"$created")
    herdr tab rename "$agent_tab" "$tab_label" >/dev/null
    editor_pane=$(herdr tab create --workspace "$ws_id" --cwd "$root" --label editor+terminal --no-focus |
      jq -r '.result.root_pane.pane_id')
    # Shell at bottom 25%; the editor keeps the top pane, like the tmux layout
    herdr pane split "$editor_pane" --direction down --ratio 0.75 --cwd "$root" --no-focus >/dev/null
    herdr pane run "$agent_pane" "$agent$continue_flag" >/dev/null
    herdr pane run "$editor_pane" "$EDITOR ." >/dev/null
    mkdir -p "$state_dir"
    {
      [[ -f $state_file ]] && awk -F '\t' -v l="$ws_label" '$1 != l' "$state_file"
      printf '%s\t%s\t%s\n' "$ws_label" "$ws_id" "$root"
    } >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"
    herdr workspace focus "$ws_id" >/dev/null
  fi

  # Inside herdr the focus switch above is the whole job; outside, attach
  if [[ -z $HERDR_PANE_ID ]]; then
    herdr
  fi
}
