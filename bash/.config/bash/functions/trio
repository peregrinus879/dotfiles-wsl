# Create or resume a Trio Dev Workspace: one tmux session per project with
# full-width Claude Code and OpenCode windows plus an editor/shell window.
# Layout: 1:claude-code | 2:opencode | 3:editor+terminal ($EDITOR over a 25% shell)
# Usage: trio [-c]   (-c continues each AI's last conversation in this project)
trio() {
  local continue_flag=""
  if [[ $1 == "-c" ]]; then
    continue_flag=" -c"
  elif [[ -n $1 ]]; then
    echo "Usage: trio [-c]"
    return 1
  fi

  local root session existing_root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(pwd -P)
  # Replace dots/colons, which tmux disallows in session names
  session=$(basename "$root" | tr '.:' '--')

  if tmux has-session -t "=$session" 2>/dev/null; then
    existing_root=$(tmux show-option -t "$session" -qv @trio_root)
    if [[ -n $existing_root && $existing_root != "$root" ]]; then
      echo "tmux session '$session' belongs to $existing_root; kill it or attach manually."
      return 1
    fi
    [[ -n $continue_flag ]] && echo "trio: session exists, -c ignored"
  else
    local editor_pane
    tmux new-session -d -s "$session" -c "$root" -n claude-code
    tmux set-option -t "$session" @trio_root "$root"
    tmux new-window -t "=$session:" -n opencode -c "$root"
    editor_pane=$(tmux new-window -t "=$session:" -n editor+terminal -c "$root" -P -F '#{pane_id}')
    # Shell at bottom 25%; the split leaves the new bottom pane focused on purpose,
    # so entering the window lands on the terminal ($editor_pane stays the top pane)
    tmux split-window -v -p 25 -t "$editor_pane" -c "$root"
    tmux send-keys -t "=$session:claude-code" "claude$continue_flag" C-m
    tmux send-keys -t "=$session:opencode" "opencode$continue_flag" C-m
    tmux send-keys -t "$editor_pane" "$EDITOR ." C-m
    tmux select-window -t "=$session:claude-code"
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}
